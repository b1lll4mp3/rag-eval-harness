# rag-eval-harness — every endpoint is env-configurable. Copy what you need.
# All defaults assume the stack is reachable on localhost.

# ---- run_eval.py ----------------------------------------------------------
# OpenAI-compatible chat endpoint of the RAG under test
RAG_URL=http://localhost:8090/v1/chat/completions
# model name the RAG endpoint expects on requests
RAG_MODEL=my-rag
# Ollama chat endpoint used for the LLM judge
JUDGE_URL=http://localhost:11434/api/chat
JUDGE_MODEL=qwen2.5:7b-instruct-q4_K_M
# base URL probed for /api/indexed (corpus snapshot recorded into each result)
RAG_BASE=http://localhost:8090

# ---- bench_lane.py --------------------------------------------------------
BENCH_BASE=http://localhost:8010/v1
BENCH_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ

# ---- ingest_health.py -----------------------------------------------------
# RAG_BASE (above) plus: space-separated local dirs that hold corpus documents
WATCH_DIRS="docs notes"

# ---- server/ (RAG test runner web UI) ------------------------------------
# optional remote gold-set URL; empty means use the bundled server/gold_set.json
GOLD_URL=
VLLM_CONTAINER=vllm
RAG_CONTAINER=rag-uploader
OLLAMA_URL=http://127.0.0.1:11434
RERANKER_HEALTH=http://127.0.0.1:8090/health/reranker
VLLM_MODELS_URL=http://127.0.0.1:8010/v1/models
BASELINE_MODEL=qwen2.5:7b-instruct-q4_K_M
RAG_REQUEST_MODEL=my-rag
QUERY_TIMEOUT=300
